<idea-plugin>
    <id>com.binzaru.swagger-autocomplete</id>
    <name>Swagger Autocomplete for SQL</name>
    <vendor email="your@email.com">Binzaru</vendor>

    <description><![CDATA[
    Autocomplete for SQL aliases based on Swagger/OpenAPI schema.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <completion.contributor
                language="any"
                implementationClass="com.binzaru.swaggerplugin.completion.ModelNameCompletionContributor"/>

        <completion.contributor
                language="any"
                implementationClass="com.binzaru.swaggerplugin.completion.AliasCompletionContributor"/>

        <annotator
                language="TEXT"
                implementationClass="com.binzaru.swaggerplugin.highlighting.Highlighter"/>

        <annotator
                language="TEXT"
                implementationClass="com.binzaru.swaggerplugin.validation.ModelNameValidator"/>

        <annotator
                language="TEXT"
                implementationClass="com.binzaru.swaggerplugin.validation.SwaggerPathValidator"/>

        <annotator
                language="TEXT"
                implementationClass="com.binzaru.swaggerplugin.validation.AliasValidator"/>

        <typedHandler
                implementation="com.binzaru.swaggerplugin.completion.SqlCompletionAutoPopup"/>
    </extensions>

    <actions>
        <action id="com.binzaru.swaggerplugin.GenerateSelect"
                class="com.binzaru.swaggerplugin.action.GenerateSelectAction"
                text="Generate SELECT from Swagger Model"
                description="Generates a SELECT statement with all fields from the Swagger model">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt G"/>
        </action>

        <action id="com.binzaru.swaggerplugin.ToggleAliasQuotes"
                class="com.binzaru.swaggerplugin.action.ToggleAliasQuotesAction"
                text="Toggle Quotes on Aliases"
                description="Adds or removes double quotes from all SQL aliases">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt Q"/>
        </action>

        <action id="com.binzaru.swaggerplugin.CopyWithoutAnnotations"
                class="com.binzaru.swaggerplugin.action.CopyWithoutAnnotationsAction"
                text="Copy Without Annotations"
                description="Copies SQL file content without @swagger and @model annotation lines">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt C"/>
        </action>
    </actions>
</idea-plugin>